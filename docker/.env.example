# Copy to docker/.env and change every value. docker/.env is ignored by Git.
# DEVELOPMENT ONLY: these services are bound to 127.0.0.1 and must never be exposed.

POSTGRES_PASSWORD=change-me-superuser
SEMANTIC_DB_OWNER_USER=nexora_semantic_owner
SEMANTIC_DB_OWNER_PASSWORD=change-me-owner
SEMANTIC_DB_APP_USER=nexora_semantic_app
SEMANTIC_DB_APP_PASSWORD=change-me-app

# Keycloak (development identity provider only)
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-keycloak-admin
KC_DEV_USER_PASSWORD=change-me-dev-users
KC_REPORTS_CLIENT_SECRET=change-me-reports-client-secret

# Tenant UUIDs (decision D2). Register the tenants first with platform.admin (POST /api/v1/admin/tenants),
# copy the returned "id" values here and recreate Keycloak:
#   docker compose -f docker/docker-compose.yml --env-file docker/.env up -d --force-recreate keycloak
# Until then tokens carry the all-zero UUID and tenant endpoints answer 403 tenant_access_denied.
KC_TENANT_DEMO_ID=00000000-0000-0000-0000-000000000000
KC_TENANT_OTHER_ID=00000000-0000-0000-0000-000000000000
